# Copy to .env (gitignored) and fill in real values for your setup.
# .env is only read locally by manage.py — never commit a filled-in copy.

# "prod" (or anything starting with it) switches settings.py to the
# production branch below; anything else (including unset) uses the
# SQLite dev defaults and doesn't require the rest of these variables.
TARGET_ENV=Dev

# --- Only read when TARGET_ENV starts with "prod" ---

# Django's secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "true"/"1"/"t" enables Django debug pages; leave unset/"0" in production.
DEBUG=0

# Space-separated hosts, e.g.: ALLOWED_HOSTS=conecacesar.azurewebsites.net
ALLOWED_HOSTS=

# Space-separated origins, e.g.: CSRF_TRUSTED_ORIGINS=https://conecacesar.azurewebsites.net
CSRF_TRUSTED_ORIGINS=

# "true"/"1"/"t" to force HTTPS redirects behind a proxy.
SECURE_SSL_REDIRECT=0

# PostgreSQL connection (used only in the prod branch).
DBNAME=
DBHOST=
DBUSER=
DBPASS=
